# Keep test fixtures byte-exact
test-data/crlf.json -text
test-data/bom.json -text
test-data/latin1.json -text

# Archives (what `uses: owner/repo@ref` downloads) only ship what the action needs
# (action.yaml, LICENSE, scripts/validate-json.py). `make check-export` checks the list.
# Everything else (tests, fixtures, workflows, tooling) is left out. Last match wins.
* export-ignore
/action.yaml -export-ignore
/LICENSE -export-ignore
/scripts -export-ignore
/scripts/* export-ignore
/scripts/validate-json.py -export-ignore
